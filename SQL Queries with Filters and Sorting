Query:-11
SELECT StudentID, Name, Age, Email
FROM Student
WHERE Age > 21;

Query:-12
SELECT CourseID, CourseName, Credits
FROM Course
WHERE InstructorID = (
SELECT InstructorID FROM Instructor WHERE Name = 'Dr. Anil Kumar'
);

Query:-13
SELECT StudentID, Name, Email
FROM Student
ORDER BY Name ASC;

Query:-14
SELECT CourseID, CourseName, Credits
FROM Course
ORDER BY Credits DESC;

Query:-15
SELECT c.CourseName, COUNT(e.StudentID) AS TotalStudents
FROM Course c
LEFT JOIN Enrollment e ON c.CourseID = e.CourseID
GROUP BY c.CourseName;

Query:-16
SELECT c.CourseName, AVG(s.Age) AS AverageAge
FROM Enrollment e
JOIN Student s ON e.StudentID = s.StudentID
JOIN Course c ON e.CourseID = c.CourseID
GROUP BY c.CourseName;

Query:-17
SELECT Name, Email
FROM Student
WHERE StudentID IN (
SELECT StudentID
FROM Enrollment
WHERE CourseID IN (
SELECT CourseID
FROM Enrollment
GROUP BY CourseID
HAVING COUNT(StudentID) > 1
)
);

Query:-18
SELECT Name, Department
FROM Instructor
WHERE InstructorID IN (
SELECT InstructorID
FROM Course
WHERE CourseID IN (
SELECT CourseID
FROM Enrollment e
JOIN Student s ON e.StudentID = s.StudentID
WHERE s.Age > 21
)
);
